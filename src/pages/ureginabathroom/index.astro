function validateCalendar(raw){
 const input=Array.isArray(raw)?raw:raw?.events;
 if(!Array.isArray(input)||input.length>10000)throw Error('Choose a calendar JSON file containing an events array (up to 10,000 events).');
 const events=input.map((e,index)=>{
  if(!e||typeof e!=='object'||!validDate(e.date)||!validTime(e.start)||!validTime(e.end)||minutes(e.end)<minutes(e.start))throw Error('Event '+(index+1)+' has an invalid date or time. Use dates from September 2026 through April 2027 and events within one day.');
  const title=typeof e.title==='string'?e.title.slice(0,500):'Campus event';
  const location=typeof e.location==='string'?e.location.slice(0,500):'';
  const building=typeof e.building==='string'&&Object.hasOwn(buildingNames,e.building)?e.building:inferBuilding(location);
  return {title,location,building,date:e.date,start:e.start,end:e.end,optional:e.optional===true,unconfirmed:e.unconfirmed===true};
 });
 return events;
}
let calendarEvents=[];
try{const stored=localStorage.getItem(CALENDAR_KEY);if(stored)calendarEvents=validateCalendar(JSON.parse(stored))}catch{}
function calendarStatus(message){$('import-status').textContent=message||(calendarEvents.length?calendarEvents.length+' calendar events available in this browser.':'No local calendar imported.');$('clear-calendar').disabled=calendarEvents.length===0}
calendarStatus();
$('import').addEventListener('change',async()=>{
 const file=$('import').files?.[0];if(!file)return;
 try{
  if(file.size>5*1024*1024)throw Error('Choose a calendar file smaller than 5 MB.');
  const events=validateCalendar(JSON.parse(await file.text()));
  let persistent=true;try{localStorage.setItem(CALENDAR_KEY,JSON.stringify(events))}catch{persistent=false}
  calendarEvents=events;fields.onlyDay.checked=true;redraw('all');save();
  calendarStatus(events.length+' events imported. '+(persistent?'Saved in this browser only.':'Available for this tab; browser storage is unavailable.'));
 }catch(error){calendarStatus(error instanceof Error?error.message:'Could not read this calendar file.')}
 $('import').value='';
});
$('clear-calendar').addEventListener('click',()=>{calendarEvents=[];try{localStorage.removeItem(CALENDAR_KEY)}catch{}fields.onlyDay.checked=false;redraw('all');save();calendarStatus()});

let current=null;
function state(){return {version:1,date:fields.date.value,time:fields.time.value,building:fields.building.value,onlyDay:fields.onlyDay.checked,ieee:fields.ieee.checked,private:fields.private.checked}}
function save(){try{localStorage.setItem('ureginabathroom-filters-v1',JSON.stringify(state()))}catch{}}
function redraw(requestedBuilding){
 const date=fields.date.value,time=fields.time.value;
 if(!validDate(date)||!validTime(time)){$('status').textContent='Choose a date from September 2026 through April 2027 and a valid time.';$('results').innerHTML='';$('details').innerHTML='';current=null;return}
 const events=calendarEvents.filter(e=>e.date===date),calendarBuildings=new Set(events.map(e=>e.building).filter(b=>buildingNames[b]));
 const todaysBuildings=new Set(calendarBuildings);if(fields.ieee.checked)todaysBuildings.add('ED');
 const allowed=fields.onlyDay.checked?[...todaysBuildings]:Object.keys(buildingNames);
 allowed.sort((a,b)=>buildingNames[a].localeCompare(buildingNames[b]));
 const old=requestedBuilding??fields.building.value??'all';
 const selected=old==='all'||allowed.includes(old)?old:'all';
 fields.building.innerHTML=`<option value="all">${fields.onlyDay.checked?'All buildings for this day':'All researched buildings'}</option>`+allowed.map(b=>`<option value="${b}">${esc(buildingNames[b])} (${b})</option>`).join('');
 fields.building.value=selected;
 let note=calendarBuildings.size?'Calendar buildings: '+[...calendarBuildings].sort().map(b=>`${buildingNames[b]} (${b})`).join(' · ')+'.':'No specific campus building is recorded for this date. Import a calendar to filter automatically by day.';
 if(events.some(e=>e.optional&&buildingNames[e.building]))note+=' Includes optional office-hour locations.';
 if(fields.ieee.checked)note+=' ED is also included for possible IEEE downtime; this does not assume you are on campus.';
 if(selected!==old)note+=' Building selection reset for this date’s filters.';
 $('building-note').textContent=note;
 const minute=minutes(time),end=minute+15;
 const busy=events.filter(e=>!e.optional&&minutes(e.start)<end&&minutes(e.end)>minute);
 const ms=Date.parse(date+'T12:00:00Z'),day=new Date(ms).getUTCDay()+1,serial=Math.round((ms-Date.parse('2026-09-01T12:00:00Z'))/86400000)+6819;
 const holiday=DATA.breaks.find(b=>b.start<=date&&date<b.end);
 const active=mapped.filter(({r})=>r[6]===day&&r[9]<=serial&&serial<=r[10]&&(r[11]||!holiday));
 const inScope=b=>(!fields.onlyDay.checked||todaysBuildings.has(b))&&(selected==='all'||selected===b);
 const scoped=DATA.candidates.filter(c=>inScope(c.building));
 const visible=scoped.filter(c=>fields.private.checked||!c.private);
 const results=visible.map(c=>{const keys=new Set();let possible=false;for(const {r,rooms} of active){if(!rooms.some(([b,f])=>b===c.building&&f===c.floor))continue;for(const t of [r[7],r[8]])if(minute-10<=t&&t<=end+10){keys.add(DATA.locations[r[3]].toUpperCase()+'|'+t);if(DATA.locations[r[3]].includes(';'))possible=true}}return {c,changes:keys.size,possible}});
 let status=`${date} · ${time}–${clock(end)} · `+(busy.length?'Overlaps your calendar: '+busy.map(e=>e.title).join('; '):'No required campus event overlaps this window.');
 if(holiday)status+=' '+holiday.title+'.';
 status+=` Showing ${results.length} washroom ${results.length===1?'option':'options'}.`;
 $('status').textContent=status;
 const body=results.map(({c,changes,possible})=>`<tr data-candidate="${esc(c.id)}" data-building="${c.building}" data-private="${c.private}"><td><a class="room" href="${c.source}#page=${c.page}" target="_blank" rel="noopener">${esc(c.name)}</a><div class="result-note">${esc(c.privacy)}</div><div class="result-note mobile-evidence">${esc(c.kind)}</div></td><td class="evidence">${esc(c.kind)}</td><td class="count">${changes}${possible?'*':''}</td></tr>`).join('');
 const hidden=scoped.filter(c=>c.private&&!fields.private.checked).length;
 const gaps=allowed.filter(b=>inScope(b)&&!DATA.candidates.some(c=>c.building===b));
 const scopeEmpty=fields.onlyDay.checked&&!todaysBuildings.size;
 $('results').innerHTML=(body?`<div class="table-responsive"><table aria-label="Filtered washroom options"><thead><tr><th class="option" scope="col">Washroom option</th><th class="evidence" scope="col">Why it fits</th><th class="count" scope="col">Changes<br><span class="small">on floor</span></th></tr></thead><tbody>${body}</tbody></table></div>`:`<p class="empty">${scopeEmpty?'No calendar buildings to show. Turn off “Only buildings on this day” to browse all researched buildings.':'No verified washroom candidate matches these filters.'}</p>`)+(hidden?`<p class="small">${hidden} private ${hidden===1?'option is':'options are'} hidden. Switch on “Include private washrooms” to show ${hidden===1?'it':'them'}.</p>`:'')+(gaps.length?`<p class="small">A suitable stall has not been verified in ${esc(gaps.map(b=>buildingNames[b]+' ('+b+')').join(', '))}. No suitable option is listed for these buildings.</p>`:'');
 $('events').innerHTML=events.length?events.map(e=>`<div class="event"><span>${esc(e.start)}–${esc(e.end)}</span><span>${esc(e.title)}${e.optional?' · optional':''}${e.unconfirmed?' · unconfirmed':''}<br><span class="small">${esc(e.location)}</span></span></div>`).join(''):'<p>No campus event is recorded on this date.</p>';
 $('details').innerHTML=results.length?results.map(({c})=>`<h3>${esc(c.name)}</h3><p>${esc(c.space)} ${esc(c.note)} <a href="${c.source}#page=${c.page}" target="_blank" rel="noopener">Floor plan</a></p>`).join(''):'<p>No displayed washroom to describe.</p>';
 current={...state(),calendarEventCount:calendarEvents.length,calendarBuildings:[...calendarBuildings].sort(),allowedBuildings:allowed,visibleIds:results.map(x=>x.c.id),visibleBuildings:[...new Set(results.map(x=>x.c.building))],counts:results.map(x=>[x.c.id,x.changes]),hiddenPrivate:hidden,unverifiedBuildings:gaps,conflicts:busy.length};
}
function restore(raw){const s=raw?.privateContent??raw;if(!s||typeof s!=='object')return false;if(validDate(s.date))fields.date.value=s.date;if(validTime(s.time))fields.time.value=s.time;for(const k of ['onlyDay','ieee','private'])if(typeof s[k]==='boolean')fields[k].checked=s[k];redraw(typeof s.building==='string'?s.building:'all');return true}
let saved;try{saved=JSON.parse(localStorage.getItem('ureginabathroom-filters-v1')||'null')}catch{}
if(!restore(saved))redraw('all');
for(const field of Object.values(fields))field.addEventListener('change',()=>{redraw();save()});
fields.time.addEventListener('input',()=>{redraw();if(validTime(fields.time.value))save()});
window.campusFinderCheck=()=>({...current,width:document.documentElement.scrollWidth,viewport:innerWidth});
console.log('Campus finder ready');
})();
</script></body></html>
