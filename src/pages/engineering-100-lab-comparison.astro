---
import { designs } from '../data/press-designs';
import identityFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Analytics from '@vercel/analytics/astro';
import DifficultySignal from '../components/DifficultySignal.astro';
import comparisonStyles from '../styles/press-comparison.css?inline';
const base = '/engineering-100/';
const rankedDesigns = [designs[1], designs[0], designs[2], designs[3]];
const difficultyLevels: Record<string, number> = { geared: 4, compound: 3, twist: 2, bench: 1 };
const challenges: Record<string, string> = { compound: 'Pivot spacing & ram travel', geared: 'Gears, threads & coupled motion', twist: 'Thread clearances & removable joints', bench: 'Swinging head & basket clearance' };
---
<!doctype html><html lang="en" data-theme="dark"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content="Four fruit press concepts: motion, exploded components and Solid Edge files." /><meta name="theme-color" content="#0d1315" /><link rel="icon" href="/favicon.svg" /><link rel="preload" href={identityFont} as="font" type="font/woff2" crossorigin="anonymous" /><title>Fruit press comparison · ENGG 100</title><style is:inline set:html={comparisonStyles}></style></head>
<body><a class="skip" href="#main">Skip to models</a><header class="masthead wrap"><a class="wordmark" href="/">nosa<span>.dev</span></a><span>ENGG 100</span><nav aria-label="Page"><a href="#comparison">Comparison</a><a href="/engineering-100-lab-comparison/mergers">Merged concepts</a><a href="#captures">Solid Edge captures</a></nav></header>
<main id="main" class="wrap"><div class="page-heading"><h1>Fruit press comparison</h1><span>4 designs</span></div>
<section id="explore" class="workbench" aria-label="Interactive fruit press models">
<div class="design-tabs" role="tablist" aria-label="Press design">{designs.map((d,i)=><button type="button" role="tab" id={`tab-${d.id}`} aria-selected={i===0?'true':'false'} aria-controls="design-panel" data-model={d.id}><span>{d.number}</span><span class="tab-copy"><strong>{d.name}</strong><small>{d.owner}</small></span></button>)}</div>
<div id="design-panel" role="tabpanel" aria-labelledby="tab-compound">
<div class="scene-toolbar"><div class="views" role="group" aria-label="Camera"><button type="button" data-view="iso" aria-pressed="true">Isometric</button><button type="button" data-view="front" aria-pressed="false">Front</button><button type="button" data-view="top" aria-pressed="false">Top</button><button id="fit" type="button">Fit all</button></div><button id="compare-toggle" type="button" aria-pressed="false">＋ Compare</button></div>
<div class="stages" id="stages">
<div class="stage" id="stage-primary"><div class="stage-header"><h2><span data-stage-name>{designs[0].name}</span><small id="stage-owner">{designs[0].owner}</small></h2><span class="component-count">20 components</span></div><div class="viewport"><img class="fallback" src={`${base}compound/preview.webp`} alt="Compound lever press in Solid Edge" /><canvas aria-label="Interactive fruit press model" role="img"></canvas><div class="part-labels" aria-label="Exploded components"></div><div class="loading" role="status">Loading model…</div><span class="gesture-hint">Drag to rotate · Scroll to zoom</span></div></div>
<div class="stage" id="stage-secondary" hidden><div class="stage-header"><select id="compare-model" aria-label="Comparison design">{designs.map(d=><option value={d.id} selected={d.id==='bench'}>{d.owner} · {d.name}</option>)}</select><span class="component-count"></span></div><div class="viewport"><canvas aria-label="Interactive comparison model" role="img"></canvas><div class="part-labels" aria-label="Exploded comparison components"></div><div class="loading" role="status">Loading model…</div><span class="gesture-hint secondary-readout"></span></div></div>
</div>
<div class="motion-controls"><button id="play" class="primary" type="button" aria-pressed="false">▶ Play</button><div class="scrubber"><div><label for="motion">Motion</label><output id="motion-value" for="motion" aria-live="off">0%</output></div><input id="motion" type="range" min="0" max="1000" value="0" step="1" aria-label="Motion from open to pressed" /><div class="range-ends"><button type="button" id="state-open">Open</button><button type="button" id="state-loading" aria-pressed="false" hidden>Load berries</button><button type="button" id="state-pressed">Pressed</button></div></div><output id="state-readout" aria-live="off">Plate drop · 0.0 mm</output><button id="reset" type="button">Reset</button></div>
<div class="inspection-controls"><button id="explode-toggle" type="button" aria-pressed="false">Explode</button><label class="explode-range" for="explode"><span class="sr-only">Exploded separation</span><input id="explode" type="range" min="0" max="100" value="0" aria-label="Exploded separation" /><output id="explode-value" for="explode" aria-live="off">0%</output></label><label class="check"><input id="inside" type="checkbox" /> See inside</label><div class="component-picker"><label class="sr-only" for="part-select">Component</label><select id="part-select"><option value="">All components</option></select><label class="check"><input id="isolate" type="checkbox" /> Isolate</label></div><a class="download" id="active-download" href={`${base}downloads/${designs[0].download}`} download>Solid Edge files ↓</a></div>
<div class="model-foot"><span id="model-stats">15 unique parts · 20 components</span><span id="part-hint" aria-live="polite"></span><span>Models fitted independently</span></div></div>
<noscript><p>Enable JavaScript for motion. Download the CAD files below.</p></noscript></section>
<section id="comparison" class="comparison" aria-labelledby="comparison-title"><h2 id="comparison-title">Hardest to easiest to model</h2><div class="table-scroll"><table><thead><tr><th scope="col">Design</th><th scope="col">Difficulty</th><th scope="col">Geometry</th><th scope="col">Assembly</th><th scope="col">Main challenge</th><th scope="col"><span class="sr-only">Download</span></th></tr></thead><tbody>{rankedDesigns.map(d=><tr><th scope="row"><button type="button" data-explore={d.id}>{d.name} ↗</button><small>{d.owner} · {d.parts} unique parts</small></th><td><DifficultySignal level={difficultyLevels[d.id]} /></td><td>{d.shapeWork}</td><td>{d.assemblyWork}</td><td>{challenges[d.id]}</td><td><a href={`${base}downloads/${d.download}`} download aria-label={`Download ${d.name}`}>.zip ↓</a></td></tr>)}</tbody></table></div>
</section>
<details id="captures" class="captures" open><summary>Sketch & Solid Edge captures <span id="capture-name">{designs[0].name}</span></summary><div class="capture-grid"><figure id="sketch-figure"><a id="sketch-link" href={`${base}${designs[0].sketch}`} target="_blank" rel="noopener"><img id="sketch-image" src={`${base}${designs[0].sketch}`} alt="Original compound lever sketch" loading="lazy" /></a><figcaption>Original sketch</figcaption></figure><figure><a id="cad-open-link" href={`${base}compound/solid-edge-open.webp`} target="_blank" rel="noopener"><img id="cad-open" src={`${base}compound/solid-edge-open.webp`} alt="Compound lever press open in Solid Edge" loading="lazy" /></a><figcaption>Solid Edge · Open</figcaption></figure><figure id="closed-figure"><a id="cad-closed-link" href={`${base}compound/solid-edge-closed.webp`} target="_blank" rel="noopener"><img id="cad-closed" src={`${base}compound/solid-edge-closed.webp`} alt="Compound lever press closed in Solid Edge" loading="lazy" /></a><figcaption>Solid Edge · Pressed</figcaption></figure><figure id="loading-figure" hidden><a href="/engineering-100/twist/solid-edge-loading.webp" target="_blank" rel="noopener"><img src="/engineering-100/twist/solid-edge-loading.webp" alt="Berry loading chute opening into the strainer with the lid removed in Solid Edge" loading="lazy" /></a><figcaption>Solid Edge · Berry inlet · Lid removed</figcaption></figure><figure id="video-figure" hidden><video id="cad-video" controls playsinline preload="none"><source src={`${base}geared/solid-edge-motion.mp4`} type="video/mp4" /></video><figcaption>Solid Edge · Motion</figcaption></figure></div></details>
<section id="modeling-notes" class="modeling-notes" aria-labelledby="notes-title"><h2 id="notes-title">Modeling notes</h2><div class="difficulty-writeups">{rankedDesigns.map(d=><article class="difficulty-writeup" id={`difficulty-${d.id}`}><div class="writeup-heading"><div><span class="writeup-owner">{d.number} · {d.owner}</span><h3>{d.name}</h3></div><div class="writeup-rating"><DifficultySignal level={difficultyLevels[d.id]} /></div></div>{d.modelingNotes.map(note=><p>{note}</p>)}</article>)}</div></section>

<footer><span>Assumed dimensions · ANSI mm · Ordered</span><a href="/">nosa.dev ↗</a></footer></main><script id="design-data" type="application/json" set:html={JSON.stringify(designs)}></script><script>import '../scripts/press-viewer.js';</script><Analytics /></body></html>
