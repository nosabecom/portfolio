---
import { projectCoordinate } from '../lib/lagos-geography';

// Set each href when the blog, résumé, and project showcase destinations are ready.
const profileLinks: { label: string; href: string | null }[] = [
  { label: 'Writings', href: null },
  { label: 'Résumé', href: null },
  { label: 'Projects', href: null },
];

// Add the remaining profile URLs when available.
const socialLinks: { label: string; href: string | null; path: string }[] = [
  { label: 'LinkedIn', href: null, path: 'M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96C2 21.32 2.69 22 3.55 22h16.9c.86 0 1.55-.68 1.55-1.52V3.52C22 2.68 21.31 2 20.45 2ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.39-.74 1.36-1.52 2.79-1.52 2.98 0 3.58 1.96 3.58 4.51v5.26Z' },
  { label: 'Twitter / X', href: null, path: 'M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-7.42L5.58 22H2.45l7.94-9.08L.8 2h6.4l4.42 6.74L18.9 2Zm-1.1 18h1.73L6.25 3.89H4.4L17.8 20Z' },
  { label: 'GitHub', href: 'https://github.com/nosabecom/', path: 'M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.85 1.24 1.85 1.24 1.07 1.83 2.81 1.3 3.49.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23A11.5 11.5 0 0 1 12 6.3c1.02 0 2.05.14 3.01.41 2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.25 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.6-2.81 5.63-5.49 5.93.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5Z' },
];

const places = [
  { name: 'MAINLAND', longitude: 3.297, latitude: 6.56, kind: 'land' },
  { name: 'LAGOS LAGOON', longitude: 3.487, latitude: 6.53, kind: 'water' },
  { name: 'LAGOS ISLAND', longitude: 3.396, latitude: 6.456, kind: 'land' },
  { name: 'IKOYI', longitude: 3.438, latitude: 6.467, kind: 'land' },
  { name: 'VICTORIA ISLAND', longitude: 3.426, latitude: 6.425, kind: 'land' },
  { name: 'LEKKI', longitude: 3.568, latitude: 6.448, kind: 'land' },
  { name: 'ATLANTIC OCEAN', longitude: 3.51, latitude: 6.375, kind: 'water' },
];
---

<lagos-background data-theme="dark">
  <canvas class="terrain" aria-hidden="true"></canvas>
  <div class="interaction-surface" aria-hidden="true"></div>

  <main id="main-content">
    <div class="profile" data-no-terrain>
      <img class="profile-image" src="/profile.webp" alt="Nosa Omokaro’s purple profile avatar" width="1440" height="1440" draggable="false" fetchpriority="high" />
      <h1 class="wordmark">Nosa Omokaro<span>.</span></h1>
      <nav class="profile-nav" aria-label="Portfolio">
        <ul>
          {profileLinks.map(({ label, href }) => (
            <li>{href ? <a href={href}>{label}</a> : <span role="link" aria-disabled="true">{label}</span>}</li>
          ))}
        </ul>
      </nav>
    </div>
    <p class="sr-only">An interactive interpretation of Lagos, Nigeria. Geometric shapes follow the coastline. Move your pointer to leave a fading trail. Hold and drag to stir the shapes, then release to send a pulse. Motion follows your device’s reduced-motion preference.</p>
    <div class="map-labels" aria-hidden="true">
      {places.map((place) => {
        const [x, y] = projectCoordinate(place.longitude, place.latitude);
        return <span class:list={['place-label', place.kind]} style={`--x:${x};--y:${y}`}><i></i>{place.name}</span>;
      })}
    </div>
    <div class="north" aria-hidden="true"><span>N</span><svg viewBox="0 0 16 32" fill="none"><path d="M8 29V4M3 10l5-6 5 6" stroke="currentColor" stroke-width="1"/></svg></div>
    <div class="live-readout" aria-hidden="true"><span class="live-coordinates">6.5244° N / 3.3792° E</span></div>
  </main>

  <nav class="social-links" aria-label="Social profiles" data-no-terrain>
    {socialLinks.map(({ label, href, path }) => {
      const Tag = href ? 'a' : 'span';
      return <Tag href={href ?? undefined} target={href ? '_blank' : undefined} rel={href ? 'noopener noreferrer' : undefined} role={href ? undefined : 'link'} aria-disabled={href ? undefined : 'true'} aria-label={href ? `${label} (opens in a new tab)` : label} title={href ? label : `${label} — coming soon`}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={path}/></svg>
      </Tag>;
    })}
  </nav>
  <div class="map-utilities">
    <a class="map-credit" href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">Map data © OpenStreetMap contributors</a>
    <button class="theme-button" type="button" aria-label="Switch to light mode" title="Switch to light mode">
        <svg class="sun-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="3.3"/><path d="M10 1v2m0 14v2M1 10h2m14 0h2M3.6 3.6 5 5m10 10 1.4 1.4M3.6 16.4 5 15M15 5l1.4-1.4"/></svg>
        <svg class="moon-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16.8 11.6A7 7 0 0 1 8.4 3.2a7 7 0 1 0 8.4 8.4Z"/></svg>
      </button>
  </div>
</lagos-background>

<script>
  import { mountLagosField } from '../lib/lagos-field';

  class LagosBackground extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      this.cleanup ??= mountLagosField(this);
    }
    disconnectedCallback() {
      this.cleanup?.();
      this.cleanup = undefined;
    }
  }

  if (!customElements.get('lagos-background')) customElements.define('lagos-background', LagosBackground);
</script>

<style>
  lagos-background {
    --paper: #f2f0e6;
    --ink: #233f33;
    --muted: #586c60;
    --accent: #557a24;
    --line: #233f3326;
    --panel: #edece2;
    position: relative;
    display: block;
    isolation: isolate;
    width: 100%;
    min-height: 600px;
    height: 100svh;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    font-family: Arial, Helvetica, sans-serif;
    -webkit-tap-highlight-color: transparent;
  }
  lagos-background[data-theme='dark'] { --paper: #0b1110; --ink: #eef2df; --muted: #9eb0a2; --accent: #b9ef87; --line: #b6d0b52e; --panel: #141d19; color-scheme: dark; }
  .terrain { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .interaction-surface { position: absolute; inset: 90px 0 40px; touch-action: none; cursor: crosshair; }
  [data-drawing='true'] .interaction-surface { cursor: grabbing; }
  .profile, .north, .live-readout, .map-utilities, .social-links { position: absolute; z-index: 2; }
  [data-theme='dark'] .terrain { opacity: .42; }
  .profile { top: 50%; left: 50%; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; gap: 25px; width: max-content; max-width: calc(100% - 48px); text-align: center; }
  .profile::before { content: ''; position: absolute; z-index: -1; inset: -90px -110px; background: radial-gradient(ellipse, var(--paper) 15%, transparent 70%); pointer-events: none; }
  .profile-image { width: 156px; height: 156px; border-radius: 50%; object-fit: cover; border: 1px solid #b792f64d; box-shadow: 0 12px 48px #0003; -webkit-user-drag: none; }
  a { color: inherit; text-decoration: none; }
  a, button { touch-action: manipulation; }
  .profile, .interaction-surface, .map-labels, .north, .live-readout, .theme-button, .map-credit { -webkit-user-select: none; user-select: none; }
  button:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .wordmark { margin: 0; font-size: clamp(36px, 4.5vw, 56px); font-weight: 700; letter-spacing: -2.5px; line-height: 1.1; }
  .wordmark span { color: var(--accent); }
  .profile-nav { margin-top: -12px; color: var(--muted); font-size: 13px; letter-spacing: .2px; }
  .profile-nav ul { display: flex; align-items: center; justify-content: center; gap: 16px; margin: 0; padding: 0; list-style: none; }
  .profile-nav li { display: flex; align-items: center; gap: 16px; }
  .profile-nav li + li::before { content: '·'; opacity: .45; }
  .profile-nav a, .profile-nav span { display: block; padding: 8px 0; }
  .profile-nav a:hover { color: var(--ink); }
  .profile-nav [aria-disabled='true'] { cursor: default; }
  .place-label, .north, .map-credit, .live-readout { font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace; }
  .map-labels { position: absolute; left: var(--map-left, 0px); top: var(--map-top, 0px); width: var(--map-width, 100%); height: var(--map-height, 100%); pointer-events: none; }
  .place-label { position: absolute; left: calc(var(--x) * 100%); top: calc(var(--y) * 100%); transform: translate(-50%, -50%); display: flex; align-items: center; gap: 7px; white-space: nowrap; font-size: 8px; letter-spacing: 1px; color: var(--muted); opacity: .3; text-shadow: 0 0 5px var(--paper); }
  .place-label i { width: 3px; height: 3px; border: 1px solid currentColor; border-radius: 50%; }
  .place-label.water { font-size: 8px; letter-spacing: 2px; }
  .place-label.water i { display: none; }
  .north { display: flex; flex-direction: column; align-items: center; gap: 8px; top: 110px; right: 44px; pointer-events: none; font-size: 10px; color: var(--accent); }
  .north svg { width: 16px; height: 32px; }
  .live-readout { top: 44px; left: 44px; display: flex; flex-direction: column; align-items: flex-end; gap: 8px; font-size: 8px; letter-spacing: 1.4px; color: var(--muted); pointer-events: none; }
  .live-coordinates { color: #48564e; letter-spacing: .6px; font-variant-numeric: tabular-nums; }
  .social-links { left: 30px; bottom: 24px; display: flex; align-items: center; gap: 4px; color: var(--muted); user-select: none; }
  .social-links a, .social-links span { width: 44px; height: 44px; display: grid; place-items: center; }
  .social-links svg { width: 17px; height: 17px; opacity: .65; }
  .social-links a:hover { color: var(--accent); }
  .social-links a:hover svg, .social-links a:focus-visible svg { opacity: 1; }
  .social-links [aria-disabled='true'] { cursor: default; }
  .map-utilities { right: 22px; bottom: 24px; display: flex; align-items: center; gap: 10px; }
  .theme-button { flex: 0 0 44px; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; color: var(--muted); background: transparent; cursor: pointer; }
  .theme-button:hover svg, .theme-button:focus-visible svg { opacity: 1; }
  .theme-button svg { width: 15px; height: 15px; stroke: currentColor; stroke-width: 1.2; opacity: .6; }
  .sun-icon, [data-theme='dark'] .moon-icon { display: none; }
  [data-theme='dark'] .sun-icon { display: block; }
  .map-credit { white-space: nowrap; font-size: 8px; color: var(--muted); }
  .map-credit:hover { text-decoration: underline; }
  @media (max-width: 600px) {
    lagos-background { min-height: 560px; }
    .profile { gap: 22px; }
    .profile-image { width: 128px; height: 128px; }
    .wordmark { font-size: clamp(30px, 8vw, 38px); letter-spacing: -1.6px; }
    .north { top: 100px; right: 24px; }
    .social-links { left: 10px; bottom: 74px; }
    .map-utilities { right: 12px; bottom: 18px; gap: 6px; }
    .live-readout { top: 30px; left: 24px; font-size: 7px; }
    .place-label { font-size: 7px; letter-spacing: .5px; gap: 4px; }
    .place-label.water { font-size: 7px; letter-spacing: 1.3px; }
    .map-credit { font-size: 7px; }
  }
  @media (max-height: 620px) and (min-width: 601px) { .north { top: 90px; } }
</style>
