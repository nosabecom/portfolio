---
import { projectCoordinate } from '../lib/lagos-geography';

const places = [
  { name: 'MAINLAND', longitude: 3.297, latitude: 6.56, kind: 'land' },
  { name: 'LAGOS LAGOON', longitude: 3.487, latitude: 6.53, kind: 'water' },
  { name: 'LAGOS ISLAND', longitude: 3.396, latitude: 6.456, kind: 'land' },
  { name: 'IKOYI', longitude: 3.438, latitude: 6.467, kind: 'land' },
  { name: 'VICTORIA ISLAND', longitude: 3.426, latitude: 6.425, kind: 'land' },
  { name: 'LEKKI', longitude: 3.568, latitude: 6.448, kind: 'land' },
  { name: 'ATLANTIC OCEAN', longitude: 3.51, latitude: 6.375, kind: 'water' },
];
---

<lagos-background data-theme="dark">
  <canvas class="terrain" aria-hidden="true"></canvas>
  <div class="interaction-surface" aria-hidden="true"></div>

  <header class="site-header">
    <a class="wordmark" href="/" aria-label="Nosa home">nosa<span>.</span></a>
  </header>

  <main id="main-content">
    <h1 class="sr-only">Lagos, in little shapes</h1>
    <p class="sr-only">An interactive interpretation of Lagos, Nigeria. Geometric shapes follow the coastline. Move your pointer to leave a fading trail. Hold and drag to stir the shapes, then release to send a pulse. Motion follows your device’s reduced-motion preference.</p>
    <div class="map-labels" aria-hidden="true">
      {places.map((place) => {
        const [x, y] = projectCoordinate(place.longitude, place.latitude);
        return <span class:list={['place-label', place.kind]} style={`--x:${x};--y:${y}`}><i></i>{place.name}</span>;
      })}
    </div>
    <div class="map-margin" aria-hidden="true">
      <span class="map-index">EXPLORATION <span>001 / LAGOS</span></span>
      <span class="north"><span>N</span><svg viewBox="0 0 16 32" fill="none"><path d="M8 29V4M3 10l5-6 5 6" stroke="currentColor" stroke-width="1"/></svg></span>
    </div>
    <div class="live-readout" aria-hidden="true"><span>A GENERATIVE ATLAS</span><span class="live-coordinates">6.5244° N / 3.3792° E</span></div>
  </main>

  <a class="map-credit" href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">Map data © OpenStreetMap contributors</a>
</lagos-background>

<script>
  import { mountLagosField } from '../lib/lagos-field';

  class LagosBackground extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      this.cleanup ??= mountLagosField(this);
    }
    disconnectedCallback() {
      this.cleanup?.();
      this.cleanup = undefined;
    }
  }

  if (!customElements.get('lagos-background')) customElements.define('lagos-background', LagosBackground);
</script>

<style>
  lagos-background {
    --paper: #f2f0e6;
    --ink: #233f33;
    --muted: #586c60;
    --accent: #557a24;
    --line: #233f3326;
    --panel: #edece2;
    position: relative;
    display: block;
    isolation: isolate;
    width: 100%;
    min-height: 600px;
    height: 100svh;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    font-family: Arial, Helvetica, sans-serif;
    -webkit-tap-highlight-color: transparent;
  }
  lagos-background[data-theme='dark'] { --paper: #101816; --ink: #eef2df; --muted: #9eb0a2; --accent: #b9ef87; --line: #b6d0b52e; --panel: #18231e; color-scheme: dark; }
  .terrain { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .interaction-surface { position: absolute; inset: 90px 0 40px; touch-action: none; cursor: crosshair; }
  [data-drawing='true'] .interaction-surface { cursor: grabbing; }
  .site-header, .map-margin, .map-credit, .live-readout { position: absolute; z-index: 2; }
  .site-header { top: 32px; left: 44px; right: 44px; display: flex; align-items: center; justify-content: space-between; }
  a { color: inherit; text-decoration: none; }
  a { touch-action: manipulation; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .wordmark { font-size: 34px; font-weight: 700; letter-spacing: -2px; line-height: 1; }
  .wordmark span { color: var(--accent); }
  .place-label, .map-index, .north, .map-credit, .live-readout { font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace; }
  .map-labels { position: absolute; left: var(--map-left, 0px); top: var(--map-top, 0px); width: var(--map-width, 100%); height: var(--map-height, 100%); pointer-events: none; }
  .place-label { position: absolute; left: calc(var(--x) * 100%); top: calc(var(--y) * 100%); transform: translate(-50%, -50%); display: flex; align-items: center; gap: 7px; white-space: nowrap; font-size: 8px; letter-spacing: 1px; color: var(--muted); opacity: .3; text-shadow: 0 0 5px var(--paper); }
  .place-label i { width: 3px; height: 3px; border: 1px solid currentColor; border-radius: 50%; }
  .place-label.water { font-size: 8px; letter-spacing: 2px; }
  .place-label.water i { display: none; }
  .map-margin { top: 110px; left: 44px; right: 44px; display: flex; align-items: flex-start; justify-content: space-between; pointer-events: none; }
  .map-index { display: flex; flex-direction: column; gap: 8px; font-size: 8px; letter-spacing: 1.5px; color: var(--muted); }
  .map-index span { color: var(--ink); }
  .north { display: flex; flex-direction: column; align-items: center; gap: 8px; margin-top: 66px; font-size: 10px; color: var(--accent); }
  .north svg { width: 16px; height: 32px; }
  .live-readout { top: 110px; right: 44px; display: flex; flex-direction: column; align-items: flex-end; gap: 8px; font-size: 8px; letter-spacing: 1.4px; color: var(--muted); pointer-events: none; }
  .live-coordinates { color: var(--ink); letter-spacing: .6px; font-variant-numeric: tabular-nums; }
  .map-credit { bottom: 13px; right: 44px; font-size: 8px; color: var(--muted); }
  .map-credit:hover { text-decoration: underline; }
  @media (max-width: 600px) {
    lagos-background { min-height: 560px; }
    .site-header { top: 25px; left: 24px; right: 24px; }
    .wordmark { font-size: 32px; }
    .map-margin { top: 100px; left: 24px; right: 24px; }
    .map-index { font-size: 7px; }
    .north { margin-top: 42px; }
    .live-readout { top: 100px; right: 24px; font-size: 7px; }
    .live-readout > span:first-child { display: none; }
    .place-label { font-size: 7px; letter-spacing: .5px; gap: 4px; }
    .place-label.water { font-size: 7px; letter-spacing: 1.3px; }
    .map-credit { right: 24px; bottom: 12px; font-size: 7px; }
  }
  @media (max-height: 620px) and (min-width: 601px) { .map-margin, .live-readout { top: 90px; } }
</style>
